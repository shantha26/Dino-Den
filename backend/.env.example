PORT=5000
MONGODB_URI=mongodb://localhost:27017/kids_play_area
CLIENT_ORIGIN=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs. Set a long random value in production — anyone
# with this secret can mint valid login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# The very first account ever signed up becomes an admin automatically and is
# seeded with admin security password "0806" (Settings → Security to change
# it). No other env config is needed to get started.

# Business name, logo, GST, capacity, pricing, and membership plans are no
# longer configured via env vars — they live in MongoDB (Settings collection)
# and are editable from the Settings tab in the app.

# ── Notification credentials ─────────────────────────────────────────────────
# All notification provider credentials are stored securely in the MongoDB
# Settings document and configured via Settings → Notifications in the UI.
# The fields below are for reference only — do NOT put real credentials here.
#
# WhatsApp / SMS providers supported: twilio | wati | gupshup | none
# Email providers supported: smtp | sendgrid | mailgun | none
#
# To activate notifications:
#  1. Open the app → Settings → Notifications tab
#  2. Expand "Provider Credentials"
#  3. Select your provider and fill in credentials
#  4. Enable/disable individual events and customize templates
#  5. Click Save Notifications
